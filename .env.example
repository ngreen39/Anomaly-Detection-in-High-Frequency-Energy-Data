# Copy to .env, keep it local, and set credentials for your local MySQL server.
# Values are literal strings; optional matching quotes are stripped.
# No shell expansion, variable interpolation, or inline comments are supported.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_UNIX_SOCKET=/tmp/mysql.sock
MYSQL_USER=REPLACE_WITH_LOCAL_USER
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
# Must start with energy_dq_audit_ and MUST NOT already exist.
MYSQL_DATABASE=energy_dq_audit_local
